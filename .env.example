# ──────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in any overrides
# ──────────────────────────────────────────────────────────────────────────────

# Ollama settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_TEMPERATURE=0.0
OLLAMA_TIMEOUT_SECONDS=120

# FAISS index paths (built by scripts/build_*_index.py)
OAE_FAISS_PATH=data/oae.faiss
OAE_META_PATH=data/oae_meta.json
CTCAE_FAISS_PATH=data/ctcae.faiss
CTCAE_META_PATH=data/ctcae_meta.json

# SQLite database paths
AUDIT_DB_PATH=audit/audit.db
LEARNING_DB_PATH=audit/learning.db
RXNORM_CACHE_PATH=audit/rxnorm_cache.db
LANGGRAPH_CHECKPOINT_PATH=audit/checkpoints.db

# RxNorm REST API (NLM — no API key required)
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
RXNORM_RATE_LIMIT_PER_MIN=85

# Clinical negatives ontology
CLINICAL_NEGATIVES_PATH=data/clinical_negatives.json

# FDA DailyMed SPL
SPL_DATA_DIR=data/rsi_spl

# HITL API
HITL_API_HOST=0.0.0.0
HITL_API_PORT=8080

# Confidence thresholds by risk tier
CONFIDENCE_THRESHOLD_TIER1=0.95
CONFIDENCE_THRESHOLD_TIER2=0.85
CONFIDENCE_THRESHOLD_TIER3=0.75

# ── Phase 6: Security hardening ───────────────────────────────────────────────
# Auth DB (reviewer API keys, bcrypt-hashed)
AUTH_DB_PATH=audit/auth.db

# LangGraph checkpoint DB
CHECKPOINT_DB_PATH=checkpoints/pipeline.db

# Column-level at-rest encryption (REQUIRED for production)
# Encrypts: audit_log.extra_metadata, hitl_review_log.original_value /
#           corrected_value, hitl_queue.state_snap
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING:  Losing this key makes encrypted data UNRECOVERABLE. Back up separately.
DB_ENCRYPTION_KEY=

# PII entity-map encryption (optional, recommended)
# Same Fernet format. Encrypts token→original maps saved to PII_MAPS_DIR.
PII_ENCRYPTION_KEY=
PII_MAPS_DIR=data/pii_maps

# ── Phase 7: Governance & E2B(R3) export ──────────────────────────────────────
# PSMF generation (scripts/generate_psmf.py)
# Name/title of the system owner / data scientist for QPPV sign-off section
SYSTEM_OWNER=

# E2B(R3) XML export sender block (scripts/e2b_exporter.py)
# Identifies this system as the E2B(R3) message sender.
# Used in <senderorganization> and <messagesenderidentifier> elements.
E2B_SENDER_ID=SENDER-001
E2B_SENDER_ORG=ICSR-HITL-SYSTEM

# E2B(R3) XML export receiver block
# Identifies the target regulatory authority.
# Used in <receiverorganization> and <messagereceiveridentifier> elements.
E2B_RECEIVER_ID=RECEIVER-001
E2B_RECEIVER_ORG=REGULATORY-AUTHORITY

# NOTE — MedDRA (ADR-001):
# MedDRA LLT/PT codes are NOT populated by default (zero-cost constraint).
# <reactionmeddrapt> contains CTCAE v5 preferred terms with an ADR-001 comment.
# See governance/decisions.md for the full rationale and licence-holder upgrade path.
